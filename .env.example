# The map (Map tab + water-body detail) uses MapLibre GL JS and needs NO token —
# it works out of the box with tokenless CARTO raster tiles.
#
# Optionally point it at your own MapLibre vector style (e.g. MapTiler, Stadia
# Maps) by copying this file to `.env` and setting the URL below. Expo inlines
# EXPO_PUBLIC_* variables into the app at build time. Leave it empty to use the
# built-in default basemap.
EXPO_PUBLIC_MAP_STYLE_URL=
